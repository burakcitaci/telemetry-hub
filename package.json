{
  "name": "observability-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Local observability platform with NestJS, React, OpenTelemetry, and ClickHouse",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "yarn build:backend && yarn build:frontend",
    "build:all": "yarn build",
    "build:frontend": "yarn workspace frontend build",
    "build:backend": "yarn workspace backend build",
    "dev:frontend": "yarn workspace frontend dev",
    "dev:backend": "yarn workspace backend dev",
    "typecheck": "yarn typecheck:backend && yarn typecheck:frontend",
    "typecheck:frontend": "yarn workspace frontend tsc --noEmit --incremental false",
    "typecheck:backend": "yarn workspace backend tsc --noEmit --incremental false",
    "kind:create": "kind create cluster --name observability --config infra/kind/kind-config.yaml",
    "kind:delete": "kind delete cluster --name observability",
    "kind:load:backend": "docker build -f apps/backend/Dockerfile -t local/backend:latest . && kind load docker-image local/backend:latest --name observability",
    "helm:deploy": "helm upgrade --install observability infra/charts/observability --namespace telemetry-hub --create-namespace --wait --timeout 5m --kube-context kind-observability",
    "helm:delete": "helm uninstall observability --namespace telemetry-hub --ignore-not-found --kube-context kind-observability",
    "backend:reload": "bash infra/kind/reload-backend.sh",
    "cluster:up": "bash infra/kind/cluster-up.sh",
    "cluster:restart": "yarn helm:deploy && yarn backend:reload",
    "cluster:down": "yarn helm:delete && yarn kind:delete",
    "port:backend": "kubectl --context kind-observability port-forward svc/backend 3001:3001 -n telemetry-hub",
    "port:clickhouse": "kubectl --context kind-observability port-forward svc/clickhouse 8123:8123 -n telemetry-hub",
    "up": "yarn cluster:up",
    "down": "yarn cluster:down",
    "logs:backend": "kubectl --context kind-observability logs -n telemetry-hub -l app.kubernetes.io/name=backend --tail=100 -f",
    "logs:collector": "kubectl --context kind-observability logs -n telemetry-hub -l app.kubernetes.io/name=opentelemetry-collector --tail=100 -f",
    "status": "kubectl --context kind-observability get pods -n telemetry-hub"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
