{
  "name": "observability-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Local observability platform with NestJS, React, OpenTelemetry, and ClickHouse",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "yarn build:backend && yarn build:frontend",
    "build:frontend": "yarn workspace frontend build",
    "build:backend": "yarn workspace backend build",
    "dev:frontend": "yarn workspace frontend dev",
    "dev:backend": "yarn workspace backend dev",
    "check:frontend": "yarn workspace frontend tsc --noEmit --incremental false",
    "check:backend": "yarn workspace backend tsc --noEmit --incremental false",
    "check:all": "yarn check:backend && yarn check:frontend",
    "test:backend": "yarn workspace backend test",
    "test:onboarding": "node --test scripts/backend-onboarding.test.mjs",
    "backend:deploy": "node scripts/deploy-backend.mjs",
    "graphify": "node scripts/graphify.mjs",
    "graph:update": "node scripts/graphify.mjs update .",
    "cluster:destroy": "yarn cluster:undeploy && kind delete cluster --name observability",
    "cluster:deploy": "node infra/kind/deploy.mjs",
    "cluster:metrics": "node infra/kind/deploy.mjs --metrics-only",
    "cluster:undeploy": "helm uninstall observability --namespace telemetry-hub --ignore-not-found --kube-context kind-observability",
    "cluster:init": "node infra/kind/cluster-up.mjs",
    "cluster:reload-backend": "node infra/kind/reload-backend.mjs",
    "cluster:restart": "yarn cluster:deploy && yarn cluster:reload-backend",
    "cluster:status": "kubectl --context kind-observability get pods -n telemetry-hub",
    "ports:backend": "kubectl --context kind-observability port-forward svc/backend 3001:3001 -n telemetry-hub",
    "ports:clickhouse": "kubectl --context kind-observability port-forward svc/clickhouse 8123:8123 -n telemetry-hub",
    "logs:backend": "kubectl --context kind-observability logs -n telemetry-hub -l app.kubernetes.io/name=backend --tail=100 -f",
    "logs:collector": "kubectl --context kind-observability logs -n telemetry-hub -l app.kubernetes.io/name=opentelemetry-collector --tail=100 -f",
    "test:frontend": "yarn workspace frontend test",
    "test:integration": "yarn workspace backend test:integration",
    "test:infra": "node --test \"infra/kind/*.test.mjs\"",
    "test": "yarn test:backend && yarn test:integration && yarn test:frontend && yarn test:onboarding && yarn test:infra",
    "lint": "eslint apps scripts infra --max-warnings 0",
    "format:check": "prettier --check \"*.json\" \"*.mjs\" \".github/**/*.yml\" \"DEPLOYMENT.md\" \"docs/*.md\" \"*.yaml\" \"README*.md\" \"scripts/**/*.{mjs,js}\" \"infra/kind/**/*.{mjs,js,yaml}\"",
    "format": "prettier --write \"*.json\" \"*.mjs\" \".github/**/*.yml\" \"DEPLOYMENT.md\" \"docs/*.md\" \"*.yaml\" \"README*.md\" \"scripts/**/*.{mjs,js}\" \"infra/kind/**/*.{mjs,js,yaml}\"",
    "check:config": "yarn workspace frontend tsc --project tsconfig.node.json --noEmit",
    "verify": "yarn lint && yarn format:check && yarn check:all && yarn check:config && yarn build && yarn test:backend && yarn workspace backend test:integration:compiled && yarn test:frontend && yarn test:onboarding && yarn test:infra && yarn test:setup",
    "test:coverage": "yarn workspace backend test:coverage",
    "setup": "node scripts/setup.mjs",
    "test:setup": "node --test scripts/setup.test.mjs"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8",
    "vite": "^7.1.12",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
