{
  "name": "observability-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Local observability platform with NestJS, React, OpenTelemetry, and ClickHouse",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "yarn build:backend && yarn build:frontend",
    "build:all-apps": "yarn build",
    "build:frontend": "yarn workspace frontend build",
    "build:backend": "yarn workspace backend build",
    "dev:frontend": "yarn workspace frontend dev",
    "dev:backend": "yarn workspace backend dev",
    "check:frontend": "yarn workspace frontend tsc --noEmit --incremental false",
    "check:backend": "yarn workspace backend tsc --noEmit --incremental false",
    "check:all": "yarn check:backend && yarn check:frontend",
    "graphify": "node scripts/graphify.mjs",
    "graph:update": "node scripts/graphify.mjs update .",
    "cluster:create": "kind create cluster --name observability --config infra/kind/kind-config.yaml",
    "cluster:destroy": "yarn cluster:undeploy && kind delete cluster --name observability",
    "cluster:deploy": "bash infra/kind/deploy.sh",
    "cluster:undeploy": "helm uninstall observability --namespace telemetry-hub --ignore-not-found --kube-context kind-observability",
    "cluster:init": "bash infra/kind/cluster-up.sh",
    "cluster:reload-backend": "bash infra/kind/reload-backend.sh",
    "cluster:restart": "yarn cluster:deploy && yarn cluster:reload-backend",
    "cluster:status": "kubectl --context kind-observability get pods -n telemetry-hub",
    "ports:backend": "kubectl --context kind-observability port-forward svc/backend 3001:3001 -n telemetry-hub",
    "ports:clickhouse": "kubectl --context kind-observability port-forward svc/clickhouse 8123:8123 -n telemetry-hub",
    "logs:backend": "kubectl --context kind-observability logs -n telemetry-hub -l app.kubernetes.io/name=backend --tail=100 -f",
    "logs:collector": "kubectl --context kind-observability logs -n telemetry-hub -l app.kubernetes.io/name=opentelemetry-collector --tail=100 -f"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.12"
  }
}
