{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "68fded263d34cd52ea709553",
  "defaultBase": "main",
  "useInferencePlugins": true,
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "parallelism": false
    },
    "test": {
      "inputs": ["default", "^default", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json", "{workspaceRoot}/.eslintignore"],
      "cache": true
    }
  },
  "generators": {
    "@nx/workspace": {
      "library": {
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "component": {
        "style": "css"
      },
      "library": {
        "linter": "eslint",
        "unitTestRunner": "jest"
      }
    },
    "@nx/nest": {
      "library": {
        "linter": "eslint"
      }
    }
  }
}
