# Environment Configuration for Telemetry Hub Backend

# Application Configuration
PORT=3001
NODE_ENV=development
HOST=0.0.0.0
APP_NAME=telemetry-backend
APP_VERSION=1.0.0

# ClickHouse Database Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT=30000

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=backend-service
OTEL_SERVICE_VERSION=1.0.0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMESTAMP=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_MAX_RETRIES=3

# Database Configuration
DB_TYPE=clickhouse
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000

# Swagger Configuration
SWAGGER_TITLE=Telemetry Hub API
SWAGGER_DESCRIPTION=Telemetry Hub API documentation
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs
